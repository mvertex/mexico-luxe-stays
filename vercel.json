{
  "functions": {
    "api/booking-request.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: https://unpkg.com https://*.tile.openstreetmap.org; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/es/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/es/assets/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/es/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/es/assets/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/es/assets/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/es/assets/:path*",
      "destination": "/assets/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mexico-luxe-stays.vercel.app"
        }
      ],
      "destination": "https://www.mexicoluxestays.com/:path*",
      "permanent": true
    },
    {
      "source": "/villas/casa-corazon-luxe.html",
      "destination": "/villas/casa-corazon.html",
      "permanent": true
    },
    {
      "source": "/villas/casa-corazon-luxe",
      "destination": "/villas/casa-corazon.html",
      "permanent": true
    },
    {
      "source": "/es/villas/casa-corazon-luxe.html",
      "destination": "/es/villas/casa-corazon.html",
      "permanent": true
    },
    {
      "source": "/es/villas/casa-corazon-luxe",
      "destination": "/es/villas/casa-corazon.html",
      "permanent": true
    },
    {
      "source": "/:page(about|villas|faq|contact|terms|privacy|playa-del-carmen|valle-de-guadalupe)",
      "destination": "/:page.html",
      "permanent": true
    },
    {
      "source": "/es/:page(about|villas|faq|contact|terms|privacy|playa-del-carmen|valle-de-guadalupe)",
      "destination": "/es/:page.html",
      "permanent": true
    },
    {
      "source": "/villas/casa-de-las-estrellas",
      "destination": "/villas/casa-de-las-estrellas.html",
      "permanent": true
    },
    {
      "source": "/es/villas/casa-de-las-estrellas",
      "destination": "/es/villas/casa-de-las-estrellas.html",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/service",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact-us.html",
      "permanent": true
    },
    {
      "source": "/reserve",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/properties",
      "destination": "/villas.html",
      "permanent": true
    },
    {
      "source": "/property-list-new",
      "destination": "/villas.html",
      "permanent": true
    },
    {
      "source": "/galleries",
      "destination": "/villas.html",
      "permanent": true
    },
    {
      "source": "/special-offer",
      "destination": "/villas.html",
      "permanent": true
    },
    {
      "source": "/special-offers",
      "destination": "/villas.html",
      "permanent": true
    },
    {
      "source": "/properties/detail/:slug*",
      "destination": "/villas.html",
      "permanent": true
    },
    {
      "source": "/properties/location/playa-del-carmen",
      "destination": "/playa-del-carmen.html",
      "permanent": true
    },
    {
      "source": "/properties/location/valle-de-guadalupe",
      "destination": "/valle-de-guadalupe.html",
      "permanent": true
    },
    {
      "source": "/attractions/location/playa-del-carmen",
      "destination": "/playa-del-carmen.html",
      "permanent": true
    },
    {
      "source": "/attractions/location/valle-de-guadalupe",
      "destination": "/valle-de-guadalupe.html",
      "permanent": true
    },
    {
      "source": "/attractions/detail/:slug(adobe-guadalupe|adobe-guadalupe-1|animalon|baron-balche|bodegas-de-santo-tom.*|bruma-wine-garden|casa-magoni|cavas-del-mogor|decantos-vinicola|deckmans-en-el-mogor|el-cielo-resort-winery|el-cielo-winery-resort|fauna|finca-la-carrodilla|horseback-riding-through-the-vineyards|hot-air-balloon-rides|l-a-cetto-boutique|la-cocina-de-dona-esthela|las-nubes-winery|lechuza-vineyard|monte-xanic-bodega-vinicola|monte-xanic-winery|museum-of-the-vine-and-wine|visit-the-museum-of-the-vine-and-wine|quinta-alegria|rondo-del-valle|trevista-vineyards|vena-cava|wine-tasting-tours|xecue-vinicola)",
      "destination": "/valle-de-guadalupe.html",
      "permanent": true
    },
    {
      "source": "/attractions/:path*",
      "destination": "/playa-del-carmen.html",
      "permanent": true
    },
    {
      "source": "/attractions",
      "destination": "/playa-del-carmen.html",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/blogs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
